{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,

  "redirects": [
    { "source": "/wp-content/:path*", "destination": "/uploads/regi/:path*", "permanent": true },

    { "source": "/hu", "destination": "/", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/hu/:path*", "destination": "/", "permanent": true },
    { "source": "/en/:path*", "destination": "/", "permanent": true },

    { "source": "/rolunk", "destination": "/", "permanent": true },
    { "source": "/kepzeseink", "destination": "/", "permanent": true },
    { "source": "/kepzesi-felszereleseink", "destination": "/", "permanent": true },
    { "source": "/black-forest", "destination": "/", "permanent": true },
    { "source": "/galeria", "destination": "/", "permanent": true },
    { "source": "/arlista", "destination": "/", "permanent": true },
    { "source": "/kapcsolat", "destination": "/", "permanent": true },

    { "source": "/rolunk/:path*", "destination": "/", "permanent": true },
    { "source": "/kepzeseink/:path*", "destination": "/", "permanent": true },
    { "source": "/kepzesi-felszereleseink/:path*", "destination": "/", "permanent": true },
    { "source": "/black-forest/:path*", "destination": "/", "permanent": true },
    { "source": "/galeria/:path*", "destination": "/", "permanent": true },
    { "source": "/arlista/:path*", "destination": "/", "permanent": true },
    { "source": "/kapcsolat/:path*", "destination": "/", "permanent": true },

    { "source": "/xmlrpc.php", "destination": "/", "permanent": true },
    { "source": "/wp-login.php", "destination": "/", "permanent": true },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": true }
  ]
}
